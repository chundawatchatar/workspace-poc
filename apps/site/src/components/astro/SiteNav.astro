---
// The top bar of the home and pricing pages, in place of the sidebar the docs have: the other pages and the palette, appearance
// and shortcut buttons the sidebar footer holds elsewhere, then the sections as a row of terminal tabs, like a pane's
// tab bar in the app. The tab row scrolls sideways when it doesn't fit, and below 640px Docs and Pricing join it.
// Shell.astro's scroll spy marks the current section's tab, and site.css's `scroll-padding-top` matches the bar's
// height.
import { Keyboard, Moon, Palette, Search, SquareTerminal, Sun } from '@orch/ui/icons'
import { SECTIONS, SITE } from '../../site.config'
import GithubMark from './GithubMark.astro'
import Logo from './Logo.astro'

interface Props {
  /** The page it is drawn on, whose link is marked current. */
  current: 'overview' | 'pricing'
}

const { current } = Astro.props
const onPricing = current === 'pricing'
const sections = SECTIONS.flatMap((section) => (section.label ? [{ id: section.id, label: section.label }] : []))
const link = 'flex h-8 shrink-0 items-center rounded-md px-2.5 text-[13px] whitespace-nowrap'
const pageLink = `${link} text-dim hover:bg-raised hover:text-ink aria-[current=page]:text-ink`
const tab =
  'nav-tab flex max-w-52 min-w-24 shrink-0 items-center gap-1.5 border-r border-line px-2.5 text-xs text-faint select-none first:border-l hover:text-dim focus-visible:-outline-offset-2'
const iconButton = 'rounded-md p-1.5 text-dim hover:bg-raised hover:text-ink'
---

<header class="sticky top-0 z-20 border-b border-line bg-sidebar/90 backdrop-blur">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <div class="flex h-14 items-center gap-1">
      <a href="/" class="mr-3 flex shrink-0 items-center gap-2.5 text-ink">
        <Logo size={22} />
        <span class="text-[15px] font-semibold tracking-tight">{SITE.name}</span>
      </a>

      <div class="ml-auto flex shrink-0 items-center gap-1">
        <button
          type="button"
          data-open="palette"
          aria-label="Search"
          class="mr-1 flex h-8 items-center gap-2 rounded-md border border-line bg-bg/60 px-2 text-xs text-faint hover:border-dim/50 hover:text-dim"
        >
          <Search size={14} />
          <span class="hidden lg:inline">Search…</span>
          <kbd class="hidden lg:inline">⌘P</kbd>
        </button>
        <a href="/docs/getting-started" class={`hidden sm:flex ${pageLink}`}>Docs</a>
        <a href="/pricing" aria-current={onPricing ? 'page' : undefined} class={`hidden sm:flex ${pageLink}`}>Pricing</a>
        <a href={SITE.githubUrl} class={`hidden gap-1.5 sm:flex ${pageLink}`}>
          <GithubMark size={14} />
          GitHub
        </a>
        <span class="leader-hides flex items-center">
          <button type="button" data-action="toggle-theme" title="Toggle light / dark" aria-label="Toggle light and dark" class={iconButton}>
            <Moon size={15} className="when-dark" />
            <Sun size={15} className="when-light" />
          </button>
          <button type="button" data-open="themes" title="Choose theme" aria-label="Choose theme" class={iconButton}>
            <Palette size={15} />
          </button>
          <button type="button" data-open="help" title="Keyboard shortcuts" aria-label="Keyboard shortcuts" class={iconButton}>
            <Keyboard size={15} />
          </button>
        </span>
        <span class="leader-chip rounded bg-accent px-1.5 py-0.5 text-[11px] font-medium text-on-accent">Ctrl+B …</span>
        <a href="/docs/getting-started" class="ml-1 flex h-8 shrink-0 items-center rounded-md bg-accent px-3 text-[13px] font-medium text-on-accent hover:opacity-90">
          Install
        </a>
      </div>
    </div>

  </div>

  <div class="border-t border-line">
    <nav aria-label="Sections" class="relative mx-auto flex h-8 max-w-7xl items-stretch overflow-x-auto px-4 [scrollbar-width:none] sm:px-8">
      {
        sections.map((s) => (
          <a href={`/#${s.id}`} data-section-link={s.id} class={tab}>
            <SquareTerminal size={13} className="shrink-0" />
            <span class="truncate">{s.label}</span>
          </a>
        ))
      }
      <a href="/docs/getting-started" class="flex shrink-0 items-center px-2.5 text-xs text-dim hover:text-ink sm:hidden">Docs</a>
      <a
        href="/pricing"
        aria-current={onPricing ? 'page' : undefined}
        class="flex shrink-0 items-center px-2.5 text-xs text-dim hover:text-ink aria-[current=page]:text-ink sm:hidden"
      >
        Pricing
      </a>
    </nav>
  </div>
</header>
