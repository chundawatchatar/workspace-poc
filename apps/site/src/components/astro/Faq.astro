---
import { ChevronRight } from '@orch/ui/icons'
import { FAQ } from '../../site.config'
---

<div class="divide-y divide-line overflow-hidden rounded-lg border border-line bg-panel">
  {
    FAQ.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 text-[15px] font-medium hover:bg-raised/60 [&::-webkit-details-marker]:hidden">
          <ChevronRight size={15} className="shrink-0 text-faint transition-transform group-open:rotate-90" />
          {item.q}
        </summary>
        <p class="px-5 pb-5 pl-12 text-[15px] leading-relaxed text-dim">{item.a}</p>
      </details>
    ))
  }
</div>
