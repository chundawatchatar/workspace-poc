---
// How the pieces connect: a browser on the machine talks to the host over loopback; a browser elsewhere goes
// through the relay, which the host reaches with one outbound tunnel.
// Drawn at its desktop width and never scaled up, so the type matches the app's sizes exactly, and sharp: every
// stroke stays 1px on screen, on half-pixel coordinates.
const hair = 'vector-effect: non-scaling-stroke; fill: none;'
const box = (color = 'var(--color-line)') =>
  `fill: var(--color-panel); stroke: ${color}; vector-effect: non-scaling-stroke;`
// The app's type: names 13px semibold, paths 12px mono faint, notes 11px dim, labels 11px semibold uppercase.
const name = 'fill: var(--color-ink); font: 600 13px var(--font-sans);'
const path = 'fill: var(--color-faint); font: 12px var(--font-mono);'
const note = 'fill: var(--color-dim); font: 11px var(--font-sans);'
const label = (color: string) => `fill: ${color}; font: 600 11px var(--font-sans); letter-spacing: 0.05em;`
// A faint rail with crisp dashes flowing along it.
const rail = (color: string) => `${hair} stroke: ${color}; opacity: 0.35;`
const flow = (color: string) => `${hair} stroke: ${color}; stroke-width: 1.5; stroke-dasharray: 6 10;`
---

<figure class="rounded-md border border-line bg-sidebar p-4 sm:p-6">
  <svg
    viewBox="0 0 1040 372"
    class="mx-auto hidden h-auto w-full max-w-[1040px] md:block"
    role="img"
    aria-label="A browser on your machine talks to the host over 127.0.0.1. A browser elsewhere goes through the relay, which your host reaches through one outbound tunnel. The host runs the terminal daemon, which owns your shells and agents."
  >
    <defs>
      <marker id="head-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M0 0.5L7.5 4L0 7.5z" style="fill: var(--color-accent)"></path>
      </marker>
      <marker id="head-zoom" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M0 0.5L7.5 4L0 7.5z" style="fill: var(--color-zoom)"></path>
      </marker>
    </defs>

    <!-- Your machine -->
    <rect x="700.5" y="16.5" width="323" height="340" rx="4" style={`${hair} stroke: var(--color-line); fill: var(--color-bg);`}></rect>
    <text x="720" y="42" style={label('var(--color-faint)')}>YOUR MACHINE OR VM</text>

    <rect x="720.5" y="60.5" width="284" height="64" rx="4" style={box('var(--color-accent)')}></rect>
    <text x="736" y="87" style={name}>Host</text>
    <text x="736" y="107" style={path}>layout · git · :4599</text>

    <rect x="720.5" y="160.5" width="284" height="64" rx="4" style={box()}></rect>
    <text x="736" y="187" style={name}>Terminal daemon</text>
    <text x="736" y="207" style={note}>Keeps every shell alive past the browser</text>

    <rect x="720.5" y="260.5" width="284" height="64" rx="4" style={box()}></rect>
    <text x="736" y="287" style={name}>Shells and agents</text>
    <text x="736" y="307" style={path}>claude · codex · zsh · vim</text>

    <path d="M862.5 125V160M862.5 225V260" style={`${hair} stroke: var(--color-line)`}></path>

    <!-- Local browser, over loopback -->
    <rect x="16.5" y="60.5" width="260" height="64" rx="4" style={box('var(--color-accent)')}></rect>
    <text x="32" y="87" style={name}>Browser on your machine</text>
    <text x="32" y="107" style={path}>127.0.0.1:3210</text>
    <path d="M277 92.5H719" style={rail('var(--color-accent)')}></path>
    <path class="stream" d="M277 92.5H719" style={flow('var(--color-accent)')} marker-end="url(#head-accent)"></path>
    <text x="498" y="81" text-anchor="middle" style={label('var(--color-accent)')}>LOOPBACK ONLY · FREE</text>

    <!-- Remote browser, through the relay and the tunnel -->
    <rect x="16.5" y="260.5" width="260" height="64" rx="4" style={box('var(--color-zoom)')}></rect>
    <text x="32" y="287" style={name}>Any browser, anywhere</text>
    <text x="32" y="307" style={path}>#machine=…&key=…</text>
    <path d="M277 292.5H371" style={rail('var(--color-zoom)')}></path>
    <path class="stream" d="M277 292.5H371" style={flow('var(--color-zoom)')} marker-end="url(#head-zoom)"></path>

    <rect x="372.5" y="260.5" width="260" height="64" rx="4" style={box('var(--color-zoom)')}></rect>
    <text x="388" y="287" style={name}>Relay</text>
    <text x="388" y="307" style={note}>Forwards traffic, stores nothing</text>

    <path d="M720 108.5H666.5V292.5H633" style={rail('var(--color-zoom)')}></path>
    <path
      class="stream stream-slow"
      d="M720 108.5H666.5V292.5H633"
      style={flow('var(--color-zoom)')}
      marker-end="url(#head-zoom)"
    ></path>
    <text x="652" y="190" text-anchor="end" style={label('var(--color-zoom)')}>ONE OUTBOUND TUNNEL</text>
    <text x="652" y="207" text-anchor="end" style={note}>No ports to open</text>

    <!-- Packets: small squares riding each route. -->
    <g class="packet">
      <rect x="-2.5" y="-2.5" width="5" height="5" style="fill: var(--color-accent)">
        <animateMotion dur="2.4s" repeatCount="indefinite" path="M280 92.5H710"></animateMotion>
      </rect>
      <rect x="-2" y="-2" width="4" height="4" style="fill: var(--color-accent)">
        <animateMotion dur="1s" repeatCount="indefinite" path="M862.5 127V158"></animateMotion>
      </rect>
      <rect x="-2" y="-2" width="4" height="4" style="fill: var(--color-accent)">
        <animateMotion dur="1s" begin="-0.5s" repeatCount="indefinite" path="M862.5 227V258"></animateMotion>
      </rect>
      <rect x="-2.5" y="-2.5" width="5" height="5" style="fill: var(--color-zoom)">
        <animateMotion dur="1.3s" repeatCount="indefinite" path="M280 292.5H362"></animateMotion>
      </rect>
      <rect x="-2.5" y="-2.5" width="5" height="5" style="fill: var(--color-zoom)">
        <animateMotion dur="2.8s" repeatCount="indefinite" path="M717 108.5H666.5V292.5H640"></animateMotion>
      </rect>
    </g>
  </svg>

  <ol class="space-y-2 text-[13px] md:hidden" aria-label="How the pieces connect">
    <li class="rounded border border-accent bg-panel px-3 py-2">
      <b class="font-semibold">Browser on your machine</b>
      <span class="block font-mono text-xs text-faint">127.0.0.1:3210</span>
      <span class="block text-[11px] text-dim">Loopback only, free</span>
    </li>
    <li class="rounded border border-zoom bg-panel px-3 py-2">
      <b class="font-semibold">Or any browser, via the relay</b>
      <span class="block font-mono text-xs text-faint">#machine=…&key=…</span>
      <span class="block text-[11px] text-dim">One outbound tunnel. The relay stores nothing.</span>
    </li>
    <li class="rounded border border-line bg-bg px-3 py-2">
      <b class="font-semibold">Your machine or VM</b>
      <span class="block text-[11px] text-dim">Host → terminal daemon → shells and agents</span>
    </li>
  </ol>
</figure>
