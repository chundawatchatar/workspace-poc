---
// How the pieces connect: a browser on the machine talks to the host over loopback; a browser elsewhere goes
// through the relay, which the host reaches with one outbound tunnel.
const box = 'fill: var(--color-panel); stroke: var(--color-line);'
const label = 'fill: var(--color-ink); font: 600 13px var(--font-sans);'
const sub = 'fill: var(--color-dim); font: 11.5px var(--font-mono);'
const tag = 'font: 600 10.5px var(--font-mono); letter-spacing: 0.06em;'
---

<figure class="rounded-lg border border-line bg-sidebar p-4 sm:p-6">
  <svg
    viewBox="0 0 760 320"
    class="hidden h-auto w-full md:block"
    role="img"
    aria-label="A browser on your machine talks to the host over 127.0.0.1. A browser elsewhere goes through the relay, which your host reaches through one outbound tunnel. The host runs the terminal daemon, which owns your shells and agents."
  >
    <defs>
      <marker id="arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" style="fill: var(--color-accent)"></path>
      </marker>
      <marker id="arrow-zoom" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" style="fill: var(--color-zoom)"></path>
      </marker>
    </defs>

    <!-- Your machine -->
    <rect x="500" y="14" width="246" height="292" rx="12" style="fill: none; stroke: var(--color-accent); stroke-dasharray: 5 5; opacity: 0.6"></rect>
    <text x="516" y="38" style={`${tag} fill: var(--color-accent)`}>YOUR MACHINE OR VM</text>

    <rect x="520" y="54" width="206" height="62" rx="8" style={box}></rect>
    <text x="536" y="80" style={label}>Host</text>
    <text x="536" y="100" style={sub}>layout · git · :4599</text>

    <rect x="520" y="140" width="206" height="62" rx="8" style={box}></rect>
    <text x="536" y="166" style={label}>Terminal daemon</text>
    <text x="536" y="186" style={sub}>owns every PTY</text>

    <rect x="520" y="226" width="206" height="62" rx="8" style={box}></rect>
    <text x="536" y="252" style={label}>Shells and agents</text>
    <text x="536" y="272" style={sub}>claude · codex · zsh · vim</text>

    <path d="M623 116v22M623 202v22" style="stroke: var(--color-line); stroke-width: 2"></path>

    <!-- Local browser -->
    <rect x="14" y="54" width="196" height="62" rx="8" style="fill: var(--color-panel); stroke: var(--color-accent)"></rect>
    <text x="30" y="80" style={label}>Browser on your machine</text>
    <text x="30" y="100" style={sub}>127.0.0.1:3210</text>
    <path d="M210 85H514" style="stroke: var(--color-accent); stroke-width: 2" marker-end="url(#arrow-accent)"></path>
    <text x="300" y="76" style={`${tag} fill: var(--color-accent)`}>LOOPBACK ONLY · FREE</text>

    <!-- Remote browser and relay -->
    <rect x="14" y="226" width="196" height="62" rx="8" style="fill: var(--color-panel); stroke: var(--color-zoom)"></rect>
    <text x="30" y="252" style={label}>Any browser, anywhere</text>
    <text x="30" y="272" style={sub}>#machine=…&key=…</text>

    <rect x="262" y="226" width="186" height="62" rx="8" style="fill: var(--color-panel); stroke: var(--color-zoom)"></rect>
    <text x="278" y="252" style={label}>Relay</text>
    <text x="278" y="272" style={sub}>forwards, stores nothing</text>

    <path d="M210 257H256" style="stroke: var(--color-zoom); stroke-width: 2" marker-end="url(#arrow-zoom)"></path>
    <path d="M514 100H476V246H454" style="fill: none; stroke: var(--color-zoom); stroke-width: 2; stroke-dasharray: 6 4" marker-end="url(#arrow-zoom)"></path>
    <text x="320" y="170" style={`${tag} fill: var(--color-zoom)`}>ONE OUTBOUND TUNNEL</text>
    <text x="320" y="188" style={`${tag} fill: var(--color-faint)`}>NO PORTS TO OPEN</text>
  </svg>

  <ol class="space-y-2 text-sm md:hidden" aria-label="How the pieces connect">
    <li class="rounded-md border border-accent bg-panel px-3 py-2">
      <b class="font-semibold">Browser on your machine</b>
      <span class="block font-mono text-xs text-dim">127.0.0.1:3210 · loopback only</span>
    </li>
    <li class="rounded-md border border-zoom bg-panel px-3 py-2">
      <b class="font-semibold">Or any browser, via the relay</b>
      <span class="block font-mono text-xs text-dim">connect link · one outbound tunnel · stores nothing</span>
    </li>
    <li class="rounded-md border border-dashed border-accent/60 px-3 py-2">
      <b class="font-semibold">Your machine or VM</b>
      <span class="block font-mono text-xs text-dim">host → terminal daemon → shells and agents</span>
    </li>
  </ol>
</figure>
