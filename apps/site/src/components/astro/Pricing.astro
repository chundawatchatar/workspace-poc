---
import { Check } from '@orch/ui/icons'
import { PLANS } from '../../site.config'
import PaneFrame from './PaneFrame.astro'
---

<div class="grid gap-5 md:grid-cols-2" data-stagger>
  {
    PLANS.map((plan) => (
      <PaneFrame tabs={[plan.tab]} ring={plan.featured} bodyClass="flex flex-col p-6">
        <h3 class="text-lg font-semibold">{plan.name}</h3>
        <p class="mt-3 flex items-baseline gap-2">
          <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
          <span class="text-sm text-dim">{plan.period}</span>
        </p>
        <p class="mt-2 text-sm text-dim">{plan.note}</p>
        <ul class="mt-5 mb-6 space-y-2 text-sm">
          {plan.features.map((feature) => (
            <li class="flex gap-2.5">
              <Check size={15} className={`mt-[3px] shrink-0 ${plan.featured ? 'text-accent' : 'text-good'}`} />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <a
          href={plan.cta.href}
          class={`mt-auto flex h-9 items-center justify-center rounded-md text-sm font-medium ${
            plan.featured ? 'bg-accent text-on-accent hover:opacity-90' : 'border border-line text-ink hover:bg-raised'
          }`}
        >
          {plan.cta.label}
        </a>
      </PaneFrame>
    ))
  }
</div>
