---
import { Check, Minus } from '@orch/ui/icons'
import Faq from '../components/astro/Faq.astro'
import Pricing from '../components/astro/Pricing.astro'
import SectionHead from '../components/astro/SectionHead.astro'
import Shell from '../layouts/Shell.astro'

// true: included, false: not included, a string: included with that note.
const rows: { group: string; items: [string, boolean | string, boolean | string][] }[] = [
  {
    group: 'Workspace',
    items: [
      ['Workspaces, split panes and tabs', true, true],
      ['Real shells with your own config', true, true],
      ['Sessions that outlive the browser', true, true],
      ['Notifications on bell and OSC 9', true, true],
      ['Command palette, shortcuts, themes', true, true],
    ],
  },
  {
    group: 'Agents',
    items: [
      ['Any CLI agent', true, true],
      ['Agent state per tab (coming next)', true, true],
    ],
  },
  {
    group: 'Remote access',
    items: [
      ['Self-hosted relay', true, true],
      ['Hosted relay, no server to run', false, true],
      ['Dashboard of every linked machine', false, true],
      ['Device approval and revocation', false, 'Planned'],
      ['End-to-end encrypted traffic', false, 'Planned'],
    ],
  },
  {
    group: 'Terms',
    items: [
      ['Licence', 'MIT', 'MIT'],
      ['Machines', 'Unlimited', 'Unlimited'],
      ['Cancel anytime, local work unaffected', true, true],
    ],
  },
]
---

<Shell tab="pricing" path="~/orchestrator/pricing" title="Pricing" description="Orchestrator is free on your machine. The hosted relay is $10 per user per month.">
  <section class="canvas-grid border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-8 sm:py-20">
      <SectionHead
        path="pricing"
        title="Free on your machine. Paid only for the relay."
        lead="Every local feature is free and open source. Orchestrator runs the relay that reaches your machines from anywhere, so you don't have to."
      />
      <Pricing />
    </div>
  </section>

  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-8">
      <h2 class="mb-6 text-2xl font-bold tracking-tight">Compare plans</h2>
      <div class="overflow-x-auto rounded-lg border border-line bg-panel">
        <table class="w-full min-w-[520px] text-sm">
          <thead>
            <tr class="border-b border-line bg-sidebar text-left font-mono text-[12px] text-dim">
              <th class="px-5 py-3 font-medium">Feature</th>
              <th class="w-36 px-5 py-3 font-medium">Local · $0</th>
              <th class="w-44 px-5 py-3 font-medium text-accent">Orchestrator · $10</th>
            </tr>
          </thead>
          {
            rows.map((section) => (
              <tbody>
                <tr>
                  <th colspan="3" class="px-5 pt-5 pb-2 text-left text-[11px] font-semibold tracking-wider text-faint uppercase">
                    {section.group}
                  </th>
                </tr>
                {section.items.map(([feature, local, remote]) => (
                  <tr class="border-t border-line/60">
                    <td class="px-5 py-2.5">{feature}</td>
                    {[local, remote].map((value) => (
                      <td class="px-5 py-2.5">
                        {value === true ? (
                          <Check size={16} className="text-good" aria-label="Included" />
                        ) : value === false ? (
                          <Minus size={16} className="text-faint" aria-label="Not included" />
                        ) : (
                          <span class="text-dim">{value}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-8">
      <h2 class="mb-6 text-2xl font-bold tracking-tight">Billing questions</h2>
      <Faq />
    </div>
  </section>
</Shell>
