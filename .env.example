# Every setting for the apps, the CLI commands and compose.yaml. Copy this file to .env (`cp .env.example .env`).
# .env is gitignored; never commit real secrets. Nothing has a default in code, so each value here is required
# unless its comment says otherwise. The shell wins over the file. The loader does no variable expansion, so keep
# the URLs below in step with the ports and credentials they repeat.

# Where each app listens. The host and the local web app must stay on loopback; remote access goes through the relay.
HOST_HOST=127.0.0.1
HOST_PORT=4599
WEB_HOST=127.0.0.1
WEB_PORT=3210
CLIENT_HOST=127.0.0.1
CLIENT_PORT=3220
SERVER_HOST=127.0.0.1
SERVER_PORT=4600
SITE_HOST=127.0.0.1
SITE_PORT=3230
# The marketing site's public URL.
SITE_URL=https://orchestrator.example.com

# Local Postgres and Mailpit from compose.yaml, published on 127.0.0.1 only.
POSTGRES_USER=orch
POSTGRES_PASSWORD=orch-dev-password
POSTGRES_DB=orch
POSTGRES_PORT=5432
SMTP_PORT=1025
MAILPIT_PORT=8025

# Setting DATABASE_URL turns accounts on in apps/server, which then needs Postgres up and migrated
# (`bun run db:up`, `bun run db:migrate`) and every variable below. Unset it to run the relay alone.
DATABASE_URL=postgres://orch:orch-dev-password@127.0.0.1:5432/orch
# At least 32 bytes. Dev only; generate a real one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0123456789
# The URL the browser uses for the app: the dev client from `bun run dev:client`.
BETTER_AUTH_URL=http://127.0.0.1:3220
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Orchestrator <no-reply@orch.localhost>
# The Ed25519 key relay tickets are signed with, as <kid>:<32-byte seed>. Dev only; generate a real one with
# `bun apps/server/scripts/relay-key.ts`. Machines linked with an enrollment key trust its public half.
RELAY_SIGNING_KEY=dev-1:Yim7ou4mKHNKfoX5AbqmqilW_-JCNcrxI0Kcai7z3Gs
# Optional. Comma-separated <kid>:<public key> entries machines also trust when they link, ahead of a key rotation.
RELAY_EXTRA_PUBLIC_KEYS=
# Optional. Comma-separated exact origins, besides the server's own, that may send non-GET requests to the server API.
SERVER_TRUSTED_ORIGINS=

# Optional. To reach this machine through the local relay from `bun run dev:client`, uncomment these two.
# SERVER_URL=ws://127.0.0.1:4600
# CLIENT_URL=http://127.0.0.1:3220
