# Dev settings for the local services in compose.yaml and for apps/server.
# Copy this file to .env (`cp .env.example .env`). .env is gitignored; never commit real secrets.
POSTGRES_USER=orch
POSTGRES_PASSWORD=orch-dev-password
POSTGRES_DB=orch
# Written out in full: the loader does no variable expansion, so keep it in step with the values above.
# Setting DATABASE_URL turns accounts on in apps/server, which then needs Postgres up and migrated
# (`bun run db:up`, `bun run db:migrate`) and every variable below. Unset it to run the relay alone.
DATABASE_URL=postgres://orch:orch-dev-password@127.0.0.1:5432/orch
# At least 32 bytes. Dev only; generate a real one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0123456789
# The URL the browser uses for the app: the dev client from `bun run dev:client`.
BETTER_AUTH_URL=http://127.0.0.1:3220
# Mailpit from compose.yaml.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Orchestrator <no-reply@orch.localhost>
# Comma-separated exact origins, besides the server's own, that may send non-GET requests to the server API.
SERVER_TRUSTED_ORIGINS=
