{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/routeTree.gen.ts", "!packages/domain/migrations"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "single", "jsxQuoteStyle": "double" }
  },
  "css": { "parser": { "tailwindDirectives": true }, "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "useFocusableInteractive": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 25 } }
      },
      "correctness": { "noNestedComponentDefinitions": "error" },
      "style": {
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 500 } }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": { "paths": { "lucide-react": "Import icons from @orch/ui/icons instead." } }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**", "!packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "lucide-react": "Import icons from @orch/ui/icons instead." },
                "patterns": [
                  {
                    "group": [
                      "@orch/web",
                      "@orch/web/**",
                      "@orch/host",
                      "@orch/host/**",
                      "@orch/client",
                      "@orch/client/**",
                      "@orch/server",
                      "@orch/server/**",
                      "@orch/ptyd-bun",
                      "@orch/ptyd-bun/**",
                      "**/apps/**"
                    ],
                    "message": "Shared packages must not import from apps. Pass data and callbacks as props instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@orch/web",
                      "@orch/web/**",
                      "@orch/host",
                      "@orch/host/**",
                      "@orch/client",
                      "@orch/client/**",
                      "@orch/server",
                      "@orch/server/**",
                      "@orch/ptyd-bun",
                      "@orch/ptyd-bun/**",
                      "**/apps/**"
                    ],
                    "message": "Shared packages must not import from apps. Pass data and callbacks as props instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/**", "apps/host/**", "apps/ptyd-bun/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "lucide-react": "Import icons from @orch/ui/icons instead." },
                "patterns": [
                  {
                    "group": ["@happy-dom/**", "happy-dom", "@testing-library/**", "msw", "msw/**"],
                    "message": "Browser test tools replace fetch and WebSocket and intercept requests, which breaks tests against real servers. See the write-tests skill."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/**", "packages/shared/**", "packages/terminal/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "lucide-react": "Import icons from @orch/ui/icons instead." },
                "patterns": [
                  {
                    "group": [
                      "@orch/web",
                      "@orch/web/**",
                      "@orch/host",
                      "@orch/host/**",
                      "@orch/client",
                      "@orch/client/**",
                      "@orch/server",
                      "@orch/server/**",
                      "@orch/ptyd-bun",
                      "@orch/ptyd-bun/**",
                      "**/apps/**"
                    ],
                    "message": "Shared packages must not import from apps. Pass data and callbacks as props instead."
                  },
                  {
                    "group": ["@happy-dom/**", "happy-dom", "@testing-library/**", "msw", "msw/**"],
                    "message": "Browser test tools replace fetch and WebSocket and intercept requests, which breaks tests against real servers. See the write-tests skill."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "plugins": [
        "./biome-plugins/no-snapshots.grit",
        "./biome-plugins/no-fire-event.grit",
        "./biome-plugins/no-dom-queries.grit",
        "./biome-plugins/no-assertion-count.grit"
      ],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveNestedTestSuites": "error" },
          "style": { "noDoneCallback": "error" },
          "suspicious": { "noDuplicateTestHooks": "error" }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" } } }
    }
  ]
}
